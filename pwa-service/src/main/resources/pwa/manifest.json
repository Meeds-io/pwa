{
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "name": "$name",
  "short_name": "$name",
  "description": "$description",
  "shortcuts": $shortcuts,
  "icons": [{
    "src": "$largeIconPath/1024.png",
    "sizes": "1024x1024",
    "type": "image/png",
    "purpose": "maskable"
  }, {
    "src": "$largeIconPath/192.png",
    "sizes": "192x192",
    "type": "image/png",
    "purpose": "any"
  }, {
    "src": "$smallIconPath/144.png",
    "sizes": "144x144",
    "type": "image/png"
  }, {
    "src": "$smallIconPath/72.png",
    "sizes": "72x72",
    "type": "image/png"
  }],
  "lang": "$defaultLang",
  "dir": "$dir",
  "background_color": "$backgroundColor",
  "theme_color": "$themeColor",
  "display": "standalone",
  "display_override": [
    "tabbed",
    "window-controls-overlay"
  ],
  "launch_handler": {
    "client_mode": ["navigate-new", "auto"]
  },
  "scope_extensions": [
    {
      "origin": "$fullDomainUrl"
    }
  ],
  "handle_links": "preferred",
  "screenshots": [],
  "categories": [],
  "related_applications": [{
    "platform": "webapp",
    "url": "$fullDomainUrl/pwa/rest/manifest"
  }],
  "prefer_related_applications": true
}
